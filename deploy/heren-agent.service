[Unit]
Description=Heren Agent device agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root: shutdown/reboot/efibootmgr/systemctl restart <svc> need it.
# The agent executes no free-text commands — only the fixed action set and
# the approved_commands allowlist from /etc/heren/agent.yaml.
ExecStart=/usr/local/bin/heren-agent --config /etc/heren/agent.yaml
Restart=always
RestartSec=3
NoNewPrivileges=false
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/var/lib/heren

[Install]
WantedBy=multi-user.target
