[Unit]
Description=Nero device agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root: shutdown/reboot/efibootmgr/systemctl restart <svc> need it.
# The agent executes no free-text commands — only the fixed action set and
# the approved_commands allowlist from /etc/nero/agent.yaml.
ExecStart=/usr/local/bin/nero-agent --config /etc/nero/agent.yaml
Restart=always
RestartSec=3
NoNewPrivileges=false
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/var/lib/nero

[Install]
WantedBy=multi-user.target
